{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard.mjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/format.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/on-stop.mjs",
        "loop_limit": 1
      }
    ]
  }
}
