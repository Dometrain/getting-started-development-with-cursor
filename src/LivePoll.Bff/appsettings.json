{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "livepoll",
    "Audience": "livepoll"
  },
  "ReverseProxy": {
    "Routes": {
      "simulations": {
        "ClusterId": "simulator",
        "Order": 1,
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/admin/simulations/{**catch-all}"
        }
      },
      "simulations-root": {
        "ClusterId": "simulator",
        "Order": 1,
        "AuthorizationPolicy": "Admin",
        "Match": {
          "Path": "/admin/simulations"
        }
      },
      "results-stream": {
        "ClusterId": "api-results",
        "Order": 2,
        "Match": {
          "Path": "/polls/{pollId}/results/stream"
        }
      },
      "api": {
        "ClusterId": "api",
        "Order": 100,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "SessionAffinity": {
          "Enabled": false
        },
        "Destinations": {
          "api1": {
            "Address": "http://api1:8080/"
          },
          "api2": {
            "Address": "http://api2:8080/"
          }
        }
      },
      "api-results": {
        "SessionAffinity": {
          "Enabled": false
        },
        "HttpRequest": {
          "ActivityTimeout": "01:00:00",
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "api1": {
            "Address": "http://api1:8080/"
          },
          "api2": {
            "Address": "http://api2:8080/"
          }
        }
      },
      "simulator": {
        "Destinations": {
          "simulator": {
            "Address": "http://simulator:8080/"
          }
        }
      }
    }
  }
}
